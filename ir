#----------------------------------------------------------------- Pract 6 web scraping

import requests
from bs4 import BeautifulSoup

def webscrap(WebUrl):        
    try:
        code = requests.get(WebUrl, timeout=10)
        print("Status Code:", code.status_code)
        
        if code.status_code != 200:
            print("Failed to retrieve the webpage.")
            return

        plain = code.text          
        s = BeautifulSoup(plain, "html.parser")          
        
        # Extract Title, Headings
        tagsofinterest = ['h1', 'h2', 'h3', 'title']
        for tags in s.find_all(tagsofinterest):
            print("Tag Name:", tags.name, ", Tag Text:", tags.text.strip())

        # Extract Meta Description & Keywords
        meta_desc = s.find("meta", attrs={"name": "description"})
        meta_keywords = s.find("meta", attrs={"name": "keywords"})
        
        print("Meta Description:", meta_desc['content'] if meta_desc else "Not found")
        print("Meta Keywords:", meta_keywords['content'] if meta_keywords else "Not found")
        
        # Extract Paragraph Text
        paragraphs = s.find_all("p")
        print("\n--- Paragraphs (First 3) ---")
        for para in paragraphs[:3]:  # Limit output for readability
            print(para.text.strip())

        # Extract Links
        print("\n--- Links ---")
        for link in s.find_all("a", href=True):
            print("Href:", link['href'])
        
        # Extract Image Sources
        print("\n--- Image Sources ---")
        for img in s.find_all("img"):
            print("Image Source:", img.get('src', 'No source available'))

    except requests.exceptions.RequestException as e:
        print("Error fetching webpage:", e)

# Call the function with URLs
webscrap("https://realpython.github.io/fake-jobs/")
webscrap("https://www.aajtak.in/")

#----------------------------------------------------- PRact 7  Hits
def calscore(links, scores):
    nodes = list(links.keys())
    newscore = [0] * len(scores)
    for i in range(0, len(scores)):
        ssum = 0
        for item in links[nodes[i]]:
            index = nodes.index(item)
            ssum = ssum + scores[index]
        newscore[i] = ssum
    ssum = sum(newscore)
    for i in range(0, len(nodes)):
        newscore[i] = newscore[i] / ssum
    return newscore

nodes = input("Enter names of Nodes as string: ")
authscore = [1] * len(nodes)
hubscore = [1] * len(nodes)
indict = dict.fromkeys(nodes, "")
outdict = dict.fromkeys(nodes, "")

ans = 'y'
while ans == 'y':
    edge = input("Enter Edge:")
    indict[edge[1]] = indict[edge[1]] + edge[0]
    outdict[edge[0]] = outdict[edge[0]] + edge[1]
    ans = input("Continue?(y/n):")


#indict: shows incoming links (who points to this node)
#outdict: shows outgoing links (where this node points)
print("indict:", indict)
print("outdict:", outdict)

for itr in range(0, 3):
    newauthscore = calscore(indict, hubscore)
    newhubscore = calscore(outdict, authscore)
    authscore = newauthscore.copy()
    hubscore = newhubscore.copy()

print("Authority score:", authscore) #higher if many hubs point to it
print("Hub score:", hubscore) #higher if it points to many authorities
print("Highest authority score node:", nodes[authscore.index(max(authscore))]) 
print("Highest hub score node:", nodes[hubscore.index(max(hubscore))]) 
#--------------------------------------------------------------------------------- Pract 8 Page rank 


nodes = input("Enter names of Nodes as string: ")
n = len(nodes)
pgrank = [1/n] * len(nodes)
indict = dict.fromkeys(nodes, "")
outdict = dict.fromkeys(nodes, "")

ans = 'y'
while ans == 'y':
    edge = input("Enter Edge:")
    indict[edge[1]] = indict[edge[1]] + edge[0]
    outdict[edge[0]] = outdict[edge[0]] + edge[1]
    ans = input("Continue?(y/n):")

print("indict:", indict)
print("outdict:", outdict)

for itr in range(0, n):
    newpgrank = [0] * n
    for i in range(0, len(nodes)):
        ssum = 0
        for item in indict[nodes[i]]:
            x = pgrank[nodes.index(item)]
            y = len(outdict[item])
            ssum = ssum + (x / y)
        newpgrank[i] = ssum
    pgrank = newpgrank.copy()

#PageRank without damping uses only link structure for rank calculation
print("Page ranks without damping factor:", pgrank)
print("\nNode with max pagerank is", nodes[pgrank.index(max(pgrank))])

d = 0.85
for i in range(0, len(nodes)):
    pgrank[i] = (1 - d) / n + d * pgrank[i]

#PageRank with damping includes a damping factor to simulate random jumps and ensure rank stability.
print("\nAfter damping factor:")
print("\nNew pagerank", pgrank)
print("\nNode with max pagerank is", nodes[pgrank.index(max(pgrank))])
